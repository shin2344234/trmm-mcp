# TacticalRMM MCP server configuration. Copy to .env and fill in.
# .env is gitignored and holds live credentials - never commit it.

# --- required --------------------------------------------------------------
# Your TRMM backend API URL.
TRMM_API_URL=https://api.example.com

# API keys from TRMM (Settings -> Global Settings -> API Keys). Use two users:
# a read-only-scoped one, and an execution-capable one. provision_trmm_accounts.py
# creates both roles/users/keys for you.
TRMM_READONLY_API_KEY=
TRMM_COMMAND_API_KEY=

# Shared bearer token for the HTTP listener (any long random string).
TRMM_MCP_AUTH_TOKEN=

# --- mode ------------------------------------------------------------------
# readonly = 20 read tools, no execution (default and safest)
# elevate  = adds 8 execution tools, each gated by out-of-band human approval
# command  = adds execution with NO gate (for unattended automation only)
# Usually set in the systemd unit, not here (EnvironmentFile overrides it).
# TRMM_MCP_MODE=readonly

# --- approval page (elevate mode) ------------------------------------------
# Set by setup_approval_auth.py - do not edit by hand.
TRMM_MCP_APPROVAL_PASSWORD_HASH=
TRMM_MCP_APPROVAL_TOTP_SECRET=

# --- transport / TLS (usually set in the systemd unit) ---------------------
# TRMM_MCP_TRANSPORT=streamable-http
# TRMM_MCP_HTTP_HOST=127.0.0.1
# TRMM_MCP_HTTP_PORT=8770
# TRMM_MCP_TLS=true
# TRMM_MCP_PUBLIC_URL=https://your-host:8770

# --- optional hard scope ---------------------------------------------------
# Comma-separated hostnames/agent_ids execution may touch. Empty = all.
# TRMM_MCP_AGENT_ALLOWLIST=
